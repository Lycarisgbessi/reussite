generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// UTILISATEURS BACK-OFFICE (RBAC : section 16 du cahier des charges)
// Rôles : ADMIN, EDITOR_IN_CHIEF, WRITER, COMMUNITY_MANAGER, AD_MANAGER
// ─────────────────────────────────────────────────────────────
model AdminUser {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String
  password  String
  role      String       @default("WRITER")
  bio       String       @default("")
  avatarUrl String       @default("")
  twitter   String       @default("")
  linkedin  String       @default("")
  active    Boolean      @default(true)
  articles  Article[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────
// CATÉGORIES / RUBRIQUES (arborescence parent/enfant)
// ─────────────────────────────────────────────────────────────
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String     @default("")
  imageUrl    String     @default("")
  color       String     @default("#d97706")
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  order       Int        @default(0)
  showInMenu  Boolean    @default(true)
  showInHome  Boolean    @default(false)
  articles    Article[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ─────────────────────────────────────────────────────────────
// ARTICLES + TAGS + VERSIONS
// ─────────────────────────────────────────────────────────────
model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  articles ArticleTag[]
}

model Article {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  subtitle      String           @default("")
  excerpt       String           @default("")
  content       String           @default("[]")
  coverImage    String           @default("")
  coverCredit   String           @default("")
  status        String           @default("DRAFT") // DRAFT, REVIEW, SCHEDULED, PUBLISHED, ARCHIVED
  authorId      String
  author        AdminUser        @relation(fields: [authorId], references: [id])
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  featured      Boolean          @default(false)
  featuredOrder Int              @default(0)
  trending      Boolean          @default(false)
  views         Int              @default(0)
  likes         Int              @default(0)
  readingTime   Int              @default(3)
  seoTitle      String           @default("")
  seoDescription String          @default("")
  publishedAt   DateTime?
  scheduledAt   DateTime?
  tags          ArticleTag[]
  comments      Comment[]
  favorites     Favorite[]
  versions      ArticleVersion[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([slug])
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  content   String
  savedBy   String   @default("")
  createdAt DateTime @default(now())
}

model ArticleTag {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

// ─────────────────────────────────────────────────────────────
// MÉDIAS (métadonnées — stockage externalisé type Cloudinary)
// ─────────────────────────────────────────────────────────────
model Media {
  id       String   @id @default(cuid())
  url      String
  publicId String   @default("")
  filename String
  alt      String   @default("")
  caption  String   @default("")
  credit   String   @default("")
  tags     String   @default("")
  type     String   @default("image")
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// VIDÉOS (YouTube) & PODCASTS (Drive/RSS)
// ─────────────────────────────────────────────────────────────
model Video {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  youtubeId    String
  thumbnailUrl String   @default("")
  duration     String   @default("")
  playlist     String   @default("Général")
  published    Boolean  @default(true)
  views        Int      @default(0)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PodcastCollection {
  id          String             @id @default(cuid())
  title       String
  description String             @default("")
  parentId    String?
  parent      PodcastCollection? @relation("PodcastCollectionTree", fields: [parentId], references: [id])
  children    PodcastCollection[] @relation("PodcastCollectionTree")
  order       Int                @default(0)
  podcasts    Podcast[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Podcast {
  id           String             @id @default(cuid())
  title        String
  description  String             @default("")
  audioUrl     String
  duration     String             @default("")
  season       Int                @default(1)
  episode      Int                @default(1)
  collectionId String?
  collection   PodcastCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  coverImage   String             @default("")
  guests       String             @default("")
  published    Boolean            @default(true)
  plays        Int                @default(0)
  publishedAt  DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// ─────────────────────────────────────────────────────────────
// PAGES STATIQUES + MENUS
// ─────────────────────────────────────────────────────────────
model StaticPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        String   @default("")
  seoTitle       String   @default("")
  seoDescription String   @default("")
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MenuItem {
  id       String   @id @default(cuid())
  label    String
  url      String   @default("")
  location String   @default("header") // header, footer
  parentId String?
  order    Int      @default(0)
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// COMMENTAIRES
// ─────────────────────────────────────────────────────────────
model Comment {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  content     String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reply       String   @default("")
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// NEWSLETTER
// ─────────────────────────────────────────────────────────────
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  interests String   @default("")
  source    String   @default("popup")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NewsletterCampaign {
  id          String    @id @default(cuid())
  subject     String
  intro       String    @default("")
  articleIds  String    @default("")
  status      String    @default("DRAFT") // DRAFT, SCHEDULED, SENT
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  Int       @default(0)
  openRate    Float     @default(0)
  clickRate   Float     @default(0)
  createdAt   DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// PUBLICITÉ : EMPLACEMENTS + CAMPAGNES + STATS (section 6)
// ─────────────────────────────────────────────────────────────
model AdPlacement {
  id        String       @id @default(cuid())
  key       String       @unique
  label     String
  format    String       @default("970x90")
  active    Boolean      @default(true)
  campaigns AdCampaign[]
  createdAt DateTime     @default(now())
}

model AdCampaign {
  id               String       @id @default(cuid())
  placementId      String
  placement        AdPlacement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  name             String
  advertiser       String
  imageUrl         String       @default("")
  htmlCode         String       @default("")
  mediaType        String       @default("IMAGE") // IMAGE (statique/JPEG/PNG), GIF (animé), VIDEO (MP4/YouTube)
  videoUrl         String       @default("")
  targetUrl        String       @default("")
  weight           Int          @default(1)
  deviceTargeting  String       @default("ALL") // ALL, MOBILE, DESKTOP
  categoryTargeting String      @default("")
  startDate        DateTime?
  endDate          DateTime?
  active           Boolean      @default(true)
  impressions      Int          @default(0)
  clicks           Int          @default(0)
  createdAt        DateTime     @default(now())
}

// ─────────────────────────────────────────────────────────────
// RÉGLAGES SITE + FLASH INFO + CONFIG ACCUEIL + POPUP
// ─────────────────────────────────────────────────────────────
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model FlashInfo {
  id        String   @id @default(cuid())
  text      String
  link      String   @default("")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS + FAVORIS + AUDIT
// ─────────────────────────────────────────────────────────────
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  path      String   @default("")
  meta      String   @default("")
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  readerKey String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([readerKey, articleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  action    String
  details   String   @default("")
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// TRADUCTIONS AUTOMATIQUES (DeepL) — FR source → EN/ES/AR/ZH
// entityType : article, flashInfo, podcast, video, category
// data : JSON { title, subtitle, content, text, description, name ... }
// auto=false ⇒ traduction corrigée manuellement (non écrasée)
// ─────────────────────────────────────────────────────────────
model Translation {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  locale     String
  data       String   @default("{}")
  auto       Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, locale])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS PUSH (Web Push VAPID) — abonnés du site.
// ═══════════════════════════════════════════════════════════════
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// BOUTIQUE — numéros du magazine, abonnements, commandes.
// Paiement : instructions Mobile Money/virement + validation par
// la rédaction (structure prête pour CinetPay/Stripe ensuite).
// ─────────────────────────────────────────────────────────────
model MagazineIssue {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  issueNumber Int      @default(1)
  description String   @default("")
  coverUrl    String   @default("")
  coverLocked Boolean  @default(false) // vrai = garder la couverture manuelle (sinon page 1 du PDF)
  previewImages String @default("[]") // JSON: pages d'aperçu [url,…]
  priceCfa    Int      @default(5000) // FCFA
  priceEur    Int      @default(8)    // euros (vente internationale)
  pdfUrl      String   @default("")   // livré après paiement
  previewPages Int     @default(5)    // nb de pages visibles gratuitement (rendues depuis le PDF)
  pricePrintCfa Int    @default(30000) // version papier (GNF) — livraison à domicile
  pricePrintEur Int    @default(3)     // version papier ($)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  releaseDate DateTime @default(now())
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  durationMonths Int      @default(12)
  issuesCount    Int      @default(4)
  priceCfa       Int      @default(15000)
  priceEur       Int      @default(25)
  perks          String   @default("") // JSON: [avantage,…]
  active         Boolean  @default(true)
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  type          String // SINGLE | SUBSCRIPTION
  issueId       String?
  issue         MagazineIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  planId        String?
  plan          SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  buyerName     String
  buyerEmail    String
  buyerPhone    String   @default("")
  amountCfa     Int      @default(0)
  amountEur     Int      @default(0)
  currency      String   @default("XOF")
  paymentMethod String   @default("MOBILE_MONEY") // MOBILE_MONEY | BANK_TRANSFER | CARD
  paymentRef    String   @default("") // référence fournie par l'acheteur
  variant       String   @default("DIGITAL") // DIGITAL | PRINT
  deliveryAddress String @default("")  // livraison version papier
  deliveryCity    String @default("")
  deliveryNote    String @default("")
  status        String   @default("PENDING") // PENDING | PAID | CANCELLED
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}
